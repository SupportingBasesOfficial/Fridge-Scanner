{
  "name": "fridge-scanner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:api": "npm run start --workspace @fridge/api",
    "dev:api": "npm run dev --workspace @fridge/api"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2"
  }
}
